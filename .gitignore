# API keys, never commit these
.env

# Mechanic libraries (runtime state, regenerated by the pipeline)
library.json
library_card.json
library_cards.json
discarded_card.json

# Recovery / migration leftovers
*.corrupt-*
*.backup_pre_cleanup

# Heavy media — keep videos out of the repo, distribute externally
web/static/video/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# macOS
.DS_Store

# Claude session files
.claude/
work_done_so_far.md

# Personal markdown notes (already-tracked .md files like README.md
# remain tracked; this only stops new ones)
*.md
