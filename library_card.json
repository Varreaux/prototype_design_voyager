    "mechanic_name": "card_draw_on_low_hand",
    "mechanic_type": "resource",
    "description": "If a player's hand becomes empty after playing a card, they draw two new cards with random values between 1 and 10.",
    "justification": "This mechanic extends gameplay by preventing players from running out of cards too quickly, making the game potentially last longer and offering more strategic choices.",
    "python_code": "import numpy as np\n\ndef card_draw_on_low_hand(game_state: dict) -> dict:\n    current_player = game_state['current_player']\n    if not game_state['hands'][current_player]: # If the current player's hand is empty\n        # Draw two new cards (values between 1 and 10)\n        new_cards = list(np.random.randint(1, 11, size=2))\n        game_state['hands'][current_player].extend(new_cards)\n    return game_state",
